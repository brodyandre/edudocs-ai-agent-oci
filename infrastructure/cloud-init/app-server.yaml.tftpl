#cloud-config
package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - gnupg
  - lsb-release
  - jq
  - ufw

write_files:
  - path: /usr/local/sbin/edudocs-bootstrap.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      export DEBIAN_FRONTEND=noninteractive
      LOG_FILE="/var/log/edudocs-cloud-init.log"
      CLOUD_MARKER="/var/lib/edudocs/cloud-init-complete"
      APP_MARKER="/var/lib/edudocs/application-ready"

      exec > >(tee -a "$LOG_FILE") 2>&1

      if [ -f "$CLOUD_MARKER" ] && [ -f "$APP_MARKER" ]; then
        echo "EduDocs application bootstrap already completed."
        exit 0
      fi

      install -d -m 0755 /etc/apt/keyrings
      if [ ! -f /etc/apt/keyrings/docker.gpg ]; then
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /tmp/docker.asc
        gpg --dearmor -o /etc/apt/keyrings/docker.gpg /tmp/docker.asc
        chmod a+r /etc/apt/keyrings/docker.gpg
        rm -f /tmp/docker.asc
      fi

      ARCH="$(dpkg --print-architecture)"
      CODENAME="$(. /etc/os-release && printf '%s' "$VERSION_CODENAME")"
      printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu %s stable\n' "$ARCH" "$CODENAME" > /etc/apt/sources.list.d/docker.list

      apt-get update
      apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

      systemctl enable docker
      systemctl start docker

      install -d -m 0755 "${application_root_dir}"
      install -d -m 0750 "${application_root_dir}/data"
      install -d -m 0750 "${application_root_dir}/logs"
      install -d -m 0755 /var/lib/edudocs
      chown -R root:root "${application_root_dir}"
      chmod 0600 "${application_root_dir}/runtime.env"

      if command -v ufw >/dev/null 2>&1; then
        ufw default deny incoming
        ufw default allow outgoing
        ufw allow from ${admin_cidr} to any port 22 proto tcp
        ufw allow from ${public_subnet_cidr} to any port ${application_host_port} proto tcp
        ufw --force enable
      fi

      systemctl daemon-reload
      systemctl enable edudocs-compose.service
      systemctl start edudocs-compose.service

      deadline=$((SECONDS + ${application_start_timeout_seconds}))
      until curl -fsS "http://127.0.0.1:${application_host_port}${application_health_path}" >/dev/null; do
        if [ "$SECONDS" -ge "$deadline" ]; then
          systemctl status edudocs-compose.service --no-pager || true
          docker compose --project-name edudocs --env-file "${application_root_dir}/runtime.env" --file "${application_root_dir}/docker-compose.yml" ps || true
          exit 1
        fi
        sleep 5
      done

      printf 'project=%s\nready_at=%s\nhealth=%s\n' "${project_name}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "http://127.0.0.1:${application_host_port}${application_health_path}" > "$APP_MARKER"
      chmod 0644 "$APP_MARKER"
      printf 'project=%s\ncompleted_at=%s\n' "${project_name}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$CLOUD_MARKER"
      chmod 0644 "$CLOUD_MARKER"

      echo "EduDocs application bootstrap completed."

  - path: ${application_root_dir}/docker-compose.yml
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, compose_content)}

  - path: ${application_root_dir}/nginx.conf
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, nginx_content)}

  - path: ${application_root_dir}/runtime.env
    owner: root:root
    permissions: "0600"
    content: |
      ${indent(6, runtime_env_content)}

  - path: /etc/systemd/system/edudocs-compose.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, systemd_content)}

runcmd:
  - [bash, /usr/local/sbin/edudocs-bootstrap.sh]

final_message: "EduDocs OCI application prepared. Check /var/log/edudocs-cloud-init.log, /var/lib/edudocs/cloud-init-complete and /var/lib/edudocs/application-ready."
