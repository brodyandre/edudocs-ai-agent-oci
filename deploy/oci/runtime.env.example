# Referencias imutaveis geradas pelo workflow Publish Images.
API_IMAGE_REF=ghcr.io/brodyandre/edudocs-ai-api@sha256:SUBSTITUA
WEB_IMAGE_REF=ghcr.io/brodyandre/edudocs-ai-web@sha256:SUBSTITUA

# Primeiro deploy publico usa providers fake para validar infraestrutura, containers,
# Load Balancer, health checks, interface e integracao sem segredos no Terraform state.
EDUDOCS_LLM_PROVIDER=fake
EDUDOCS_EMBEDDING_PROVIDER=fake
NGINX_PORT=8080
